{
  "format": 1,
  "id": "airplay",
  "version": "1.0.0-beta.4",
  "api": 2,
  "engine": "native",
  "title": {
    "ru": "AirPlay",
    "en": "AirPlay"
  },
  "description": {
    "ru": "AirPlay с совместным выводом через штатный микшер Алисы. Звук с iPhone, iPad и Mac в локальной сети.",
    "en": "AirPlay through the stock Alice shared audio mixer. Audio from iPhone, iPad and Mac on your LAN."
  },
  "author": "Alice Homebrew",
  "permissions": [
    "system.full-access",
    "log.write"
  ],
  "capabilities": [
    "audio.playback",
    "network.listen",
    "network.multicast",
    "audio.analysis"
  ],
  "config": [
    {
      "key": "name",
      "label": {
        "ru": "Имя в AirPlay",
        "en": "AirPlay name"
      },
      "type": "text",
      "default": "Alice Mini",
      "max_length": 32
    },
    {
      "key": "password",
      "label": {
        "ru": "Пароль подключения (пусто — без пароля)",
        "en": "Connection password (empty to disable)"
      },
      "type": "text",
      "default": "",
      "max_length": 64
    },
    {
      "key": "audio-mode",
      "label": {
        "ru": "Режим звука",
        "en": "Audio mode"
      },
      "type": "select",
      "default": "shared",
      "options": [
        {
          "value": "shared",
          "label": {
            "ru": "Совместно с Алисой (штатный микшер)",
            "en": "Share with Alice (stock mixer)"
          }
        },
        {
          "value": "direct",
          "label": {
            "ru": "Прямой выход (Алиса отключена)",
            "en": "Direct output (Alice disabled)"
          }
        }
      ]
    },
    {
      "key": "device",
      "label": {
        "ru": "Выход для прямого режима",
        "en": "Output for direct mode"
      },
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
            "ru": "Автоматически",
            "en": "Automatic"
          }
        },
        {
          "value": "plughw:0,0",
          "label": {
            "ru": "Карта 0 · PCM 0 (Мини 1: TDM-B)",
            "en": "Card 0 · PCM 0 (Mini 1: TDM-B)"
          }
        },
        {
          "value": "plughw:0,1",
          "label": {
            "ru": "Карта 0 · PCM 1 (Мини 1: TDM-C)",
            "en": "Card 0 · PCM 1 (Mini 1: TDM-C)"
          }
        }
      ]
    },
    {
      "key": "max-volume",
      "label": {
        "ru": "Максимальная громкость, дБ",
        "en": "Maximum volume, dB"
      },
      "type": "range",
      "default": -10,
      "min": -60,
      "max": 0,
      "step": 1
    },
    {
      "key": "port",
      "label": {
        "ru": "Порт AirPlay",
        "en": "AirPlay port"
      },
      "type": "range",
      "default": 7000,
      "min": 1024,
      "max": 65535,
      "step": 1
    }
  ],
  "module_sha256": "f72fd1b8c950ee2aeae38087e2c21fc94afa5fe66a3bd368c8d3bcb90f25dd6f",
  "runtime_storage_bytes": 6244712
}
